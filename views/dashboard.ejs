<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | Orneau Festival</title>
    <meta name="description" content="Tableau de bord des résultats du sondage du festival de Gembloux.">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.png">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/dashboard.js" defer></script>
</head>

<body>
<main class="dashboard">
    <div class="dashboard__container">

        <header class="dashboard-header">
            <div class="dashboard-header__brand">
                <img src="/images/Armoiries_Gembloux.png" alt="Armoiries de Gembloux" class="dashboard-header__logo">

                <div>
                    <p class="dashboard-header__eyebrow">Orneau Festival - <%= name %></p>
                    <h1>Tableau de bord</h1>
                    <p class="dashboard-header__description">
                        Résultats du questionnaire et attentes du public.
                    </p>
                </div>
            </div>

            <div class="dashboard-header__actions">
                <button type="button" class="refresh-button" id="refresh-button">
                    <span aria-hidden="true">↻</span>
                    Actualiser
                </button>

                <% if (role === "organisateur") { %>
                    <button
                            type="button"
                            class="add-user-button"
                            id="open-user-modal"
                    >
                        <span aria-hidden="true">+</span>
                        Ajouter un utilisateur
                    </button>
                <% } %>

                <form action="/admin/logout" method="POST" class="logout-form">
                    <button type="submit" class="logout-button">
                        <span aria-hidden="true">↪</span>
                        Déconnexion
                    </button>
                </form>
            </div>

        </header>

        <section class="dashboard-section" aria-labelledby="interest-title">
            <div class="section-heading">
                <div>
                    <p class="section-heading__eyebrow">01 — Participation</p>
                    <h2 id="interest-title">Intérêt pour le festival</h2>
                </div>

                <span class="section-heading__tag" id="response-count">
                    Chargement...
                </span>
            </div>

            <div class="stats-grid">
                <article class="stat-card stat-card--yes">
                    <div class="stat-card__top">
                        <span class="stat-card__label" id="procent_interested">--</span>
                        <span class="stat-card__icon" aria-hidden="true">↗</span>
                    </div>
                    <p class="stat-card__value" id="yes-count">—</p>
                    <p class="stat-card__description">Réponses positives</p>
                </article>

                <article class="stat-card stat-card--maybe">
                    <div class="stat-card__top">
                        <span class="stat-card__label" id="procent_maybe">--</span>
                        <span class="stat-card__icon" aria-hidden="true">?</span>
                    </div>
                    <p class="stat-card__value" id="maybe-count">—</p>
                    <p class="stat-card__description">Réponses incertaines</p>
                </article>

                <article class="stat-card stat-card--no">
                    <div class="stat-card__top">
                        <span class="stat-card__label" id="procent_no">--</span>
                        <span class="stat-card__icon" aria-hidden="true">—</span>
                    </div>
                    <p class="stat-card__value" id="no-count">—</p>
                    <p class="stat-card__description">Réponses négatives</p>
                </article>
            </div>
        </section>


        <section class="dashboard-section" aria-labelledby="mobility-title">

            <div class="section-heading">
                <div>
                    <p class="section-heading__eyebrow">02 — Déplacements</p>
                    <h2 id="mobility-title">Mobilité des participants</h2>
                    <p class="section-heading__description">
                        Moyens de transport privilégiés pour rejoindre le festival.
                    </p>
                </div>
            </div>

            <div class="mobility-panel">

                <div class="mobility-row">
                    <div class="mobility-transport">
                        <span class="mobility-icon" aria-hidden="true">🚌</span>
                        <span>Bus</span>
                    </div>
                    <div class="mobility-progress">
                        <div class="mobility-progress__track">
                            <span id="transport-bus-bar"></span>
                        </div>
                    </div>
                    <div class="mobility-stats">
                        <strong id="transport-bus">—</strong>
                        <span>pers. /</span>
                        <strong id="transport-bus-pourcentage">—</strong>
                        <span>%</span>
                    </div>
                </div>

                <div class="mobility-row">
                    <div class="mobility-transport">
                        <span class="mobility-icon" aria-hidden="true">🚆</span>
                        <span>Train</span>
                    </div>
                    <div class="mobility-progress">
                        <div class="mobility-progress__track">
                            <span id="transport-train-bar"></span>
                        </div>
                    </div>
                    <div class="mobility-stats">
                        <strong id="transport-train">—</strong>
                        <span>pers. /</span>
                        <strong id="transport-train-pourcentage">—</strong>
                        <span>%</span>
                    </div>
                </div>

                <div class="mobility-row">
                    <div class="mobility-transport">
                        <span class="mobility-icon" aria-hidden="true">🚗</span>
                        <span>Voiture</span>
                    </div>
                    <div class="mobility-progress">
                        <div class="mobility-progress__track">
                            <span id="transport-voiture-bar"></span>
                        </div>
                    </div>
                    <div class="mobility-stats">
                        <strong id="transport-voiture">—</strong>
                        <span>pers. /</span>
                        <strong id="transport-voiture-pourcentage">—</strong>
                        <span>%</span>
                    </div>
                </div>

                <div class="mobility-row">
                    <div class="mobility-transport">
                        <span class="mobility-icon" aria-hidden="true">🚲</span>
                        <span>Vélo</span>
                    </div>
                    <div class="mobility-progress">
                        <div class="mobility-progress__track">
                            <span id="transport-velo-bar"></span>
                        </div>
                    </div>
                    <div class="mobility-stats">
                        <strong id="transport-velo">—</strong>
                        <span>pers. /</span>
                        <strong id="transport-velo-pourcentage">—</strong>
                        <span>%</span>
                    </div>
                </div>

                <div class="mobility-row">
                    <div class="mobility-transport">
                        <span class="mobility-icon" aria-hidden="true">🚐</span>
                        <span>Navette</span>
                    </div>
                    <div class="mobility-progress">
                        <div class="mobility-progress__track">
                            <span id="transport-navette-bar"></span>
                        </div>
                    </div>
                    <div class="mobility-stats">
                        <strong id="transport-navette">—</strong>
                        <span>pers. /</span>
                        <strong id="transport-navette-pourcentage">—</strong>
                        <span>%</span>
                    </div>
                </div>

            </div>

        </section>

        <section class="dashboard-section" aria-labelledby="profile-title">
            <div class="section-heading">
                <div>
                    <p class="section-heading__eyebrow">03 — Public</p>
                    <h2 id="profile-title">Profil des répondants</h2>
                </div>
            </div>

            <div class="stats-grid stats-grid--two">
                <article class="metric-card">
                    <div class="metric-card-item">
                        <div class="metric-card__icon" aria-hidden="true">-</div>
                        <p class="metric-card__label">Âge Min</p>
                        <p class="metric-card__value">
                            <span id="min-age">—</span>
                            <span class="metric-card__unit">ans</span>
                        </p>
                        <p class="metric-card__hint">Tous les répondants</p>
                    </div>
                    <div class="metric-card-item">
                        <div class="metric-card__icon" aria-hidden="true">↗</div>
                        <p class="metric-card__label">Âge Median</p>
                        <p class="metric-card__value">
                            <span id="median-age">—</span>
                            <span class="metric-card__unit">ans</span>
                        </p>
                    </div>
                    <div class="metric-card-item">
                        <div class="metric-card__icon" aria-hidden="true">+</div>
                        <p class="metric-card__label">Âge Max</p>
                        <p class="metric-card__value">
                            <span id="max-age">—</span>
                            <span class="metric-card__unit">ans</span>
                        </p>
                    </div>
                </article>

                <article class="metric-card">
                    <div class="metric-card-item">
                        <div class="metric-card__icon" aria-hidden="true">-</div>
                        <p class="metric-card__label">Budget Minimum</p>
                        <p class="metric-card__value">
                            <span id="min-budget">—</span>
                            <span class="metric-card__unit">€</span>
                        </p>
                        <p class="metric-card__hint">Prix accepté pour une journée</p>
                    </div>
                    <div class="metric-card-item">
                        <div class="metric-card__icon" aria-hidden="true">€</div>
                        <p class="metric-card__label">Budget Median</p>
                        <p class="metric-card__value">
                            <span id="median-budget">—</span>
                            <span class="metric-card__unit">€</span>
                        </p>
                    </div>
                    <div class="metric-card-item">
                        <div class="metric-card__icon" aria-hidden="true">+</div>
                        <p class="metric-card__label">Budget Maximal</p>
                        <p class="metric-card__value">
                            <span id="max-budget">—</span>
                            <span class="metric-card__unit">€</span>
                        </p>
                    </div>

                </article>
            </div>
        </section>

        <section class="dashboard-section artists-section"
                 aria-labelledby="artists-title">

            <div class="section-heading">
                <div>
                    <p class="section-heading__eyebrow">03 — Programmation</p>
                    <h2 id="artists-title">Artistes souhaités</h2>
                    <p class="section-heading__description">
                        Les noms les plus cités par les participants.
                    </p>
                </div>

                <button
                    type="button"
                    class="toggle-button"
                    id="toggle-artists"
                    aria-expanded="false"
                    aria-controls="artists-content"
                >
                    Voir la liste
                    <span aria-hidden="true">⌄</span>
                </button>
            </div>

            <div class="artists-content" id="artists-content" hidden>
                <div class="artists-toolbar">
                    <p id="artists-total">0 artiste cité</p>
                    <label class="artists-search">
                        <span class="visually-hidden">Rechercher un artiste</span>
                        <input
                            type="search"
                            id="artist-search"
                            placeholder="Rechercher..."
                        >
                    </label>
                </div>

                <div class="artists-list" id="artists-list">
                    <p class="empty-state">Chargement des artistes...</p>
                </div>
            </div>
        </section>

        <p class="dashboard-status" id="dashboard-status" role="status">
            Chargement des statistiques...
        </p>

        <footer class="dashboard-footer">
            <span>Orneau Festival</span>
            <span>Dashboard des résultats du sondage</span>
        </footer>

    </div>
</main>

<div class="modal-overlay" id="user-modal" aria-hidden="true">
    <section class="user-modal" role="dialog" aria-modal="true" aria-labelledby="user-modal-title">
        <div class="user-modal__header">
            <div>
                <h2 id="user-modal-title">Ajouter un utilisateur</h2>
                <p>Crée un compte pour accéder au dashboard.</p>
            </div>

            <button type="button" class="user-modal__close" id="close-user-modal" aria-label="Fermer">
                &times;
            </button>
        </div>

        <form action="/admin/users" method="POST" class="user-form">
            <div class="user-form__field">
                <label for="new-user-name">Nom</label>
                <input type="text" id="new-user-name" name="name" placeholder="Nom de l'utilisateur" required>
            </div>

            <div class="user-form__field">
                <label for="new-user-email">Adresse e-mail</label>
                <input type="email" id="new-user-email" name="email" placeholder="nom@exemple.be" required>
            </div>

            <div class="user-form__field">
                <label for="new-user-password">Mot de passe</label>
                <input type="password" id="new-user-password" name="password" minlength="12" autocomplete="new-password" placeholder="12 caractères minimum" required>
            </div>

            <div class="user-form__field">
                <label for="new-user-role">Rôle</label>
                <select id="new-user-role" name="role" required>
                    <option value="" disabled selected>Choisir un rôle</option>
                    <option value="organisateur">Organisateur</option>
                    <option value="communication">Communication</option>
                    <option value="collaborateur">Collaborateur</option>
                    <option value="benevole">Bénévole</option>
                </select>
            </div>

            <div class="user-modal__actions">
                <button type="button" class="user-modal__cancel" id="cancel-user-modal">
                    Annuler
                </button>

                <button type="submit" class="user-modal__submit">
                    Créer l'utilisateur
                </button>
            </div>
        </form>
    </section>
</div>

<script>
    (() => {
        const modal = document.getElementById("user-modal");
        const openButton = document.getElementById("open-user-modal");
        const closeButton = document.getElementById("close-user-modal");
        const cancelButton = document.getElementById("cancel-user-modal");

        if (!modal || !openButton) return;

        let previousFocus = null;

        function openModal() {
            previousFocus = document.activeElement;
            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";

            modal.querySelector("input")?.focus();
        }

        function closeModal() {
            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";

            previousFocus?.focus();
        }

        openButton.addEventListener("click", openModal);
        closeButton?.addEventListener("click", closeModal);
        cancelButton?.addEventListener("click", closeModal);

        modal.addEventListener("click", (event) => {
            if (event.target === modal) closeModal();
        });

        document.addEventListener("keydown", (event) => {
            if (
                event.key === "Escape" &&
                modal.classList.contains("is-open")
            ) {
                closeModal();
            }
        });
    })();
</script>
</body>
</html>
